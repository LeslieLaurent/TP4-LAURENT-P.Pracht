---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Penguins avec plusieurs filtres">

  <main class="mx-auto max-w-6xl px-6 py-16">

    <a
      href="/"
      class="font-bold text-[#ff9bb2] underline
             underline-offset-4"
    >
      ← Retour à l'accueil
    </a>

    <section class="py-16">

      <p
        class="text-sm font-bold uppercase
               tracking-[0.2em] text-[#ff9bb2]"
      >
        Essai 04
      </p>

      <h1
        class="mt-4 text-5xl font-bold
               text-[#fff8f5]"
      >
        Penguins avec plusieurs filtres
      </h1>

      <p
        class="mt-5 max-w-2xl
               text-lg leading-8 text-[#e6d6da]"
      >
        Le graphique est recalculé selon
        l'espèce, l'île et le sexe sélectionnés.
      </p>

    </section>

    <section
      class="mb-10 grid gap-6
             md:grid-cols-3"
    >

      <div>

        <label
          for="species"
          class="mb-2 block font-bold
                 text-[#fff8f5]"
        >
          Espèce
        </label>

        <select
          id="species"
          class="w-full rounded-xl
                 border-2 border-[#c86e87]
                 bg-[#21131b]
                 px-4 py-3
                 text-[#fff8f5]"
        >
          <option value="">
            All species
          </option>

          <option value="Adelie">
            Adelie
          </option>

          <option value="Chinstrap">
            Chinstrap
          </option>

          <option value="Gentoo">
            Gentoo
          </option>
        </select>

      </div>

      <div>

        <label
          for="island"
          class="mb-2 block font-bold
                 text-[#fff8f5]"
        >
          Île
        </label>

        <select
          id="island"
          class="w-full rounded-xl
                 border-2 border-[#c86e87]
                 bg-[#21131b]
                 px-4 py-3
                 text-[#fff8f5]"
        >
          <option value="">
            All islands
          </option>

          <option value="Biscoe">
            Biscoe
          </option>

          <option value="Dream">
            Dream
          </option>

          <option value="Torgersen">
            Torgersen
          </option>
        </select>

      </div>

      <div>

        <label
          for="sex"
          class="mb-2 block font-bold
                 text-[#fff8f5]"
        >
          Sexe
        </label>

        <select
          id="sex"
          class="w-full rounded-xl
                 border-2 border-[#c86e87]
                 bg-[#21131b]
                 px-4 py-3
                 text-[#fff8f5]"
        >
          <option value="">
            All sexes
          </option>

          <option value="MALE">
            Male
          </option>

          <option value="FEMALE">
            Female
          </option>
        </select>

      </div>

    </section>

    <p
      id="result-count"
      class="mb-5 font-bold
             text-[#ffd0db]"
      aria-live="polite"
    >
    </p>

    <div
      id="plot"
      class="overflow-hidden rounded-3xl
             border-2 border-[#704052]
             bg-[#21131b] p-6"
    >
    </div>

  </main>

  <script>
    import * as Plot from "@observablehq/plot";
    import penguins from "../assets/penguins.json";

    const selectSpecies =
      document.querySelector<HTMLSelectElement>(
        "#species"
      );

    const selectIsland =
      document.querySelector<HTMLSelectElement>(
        "#island"
      );

    const selectSex =
      document.querySelector<HTMLSelectElement>(
        "#sex"
      );

    const div =
      document.querySelector<HTMLElement>(
        "#plot"
      );

    const resultCount =
      document.querySelector<HTMLElement>(
        "#result-count"
      );

    function renderPlot() {
      if (
        !selectSpecies ||
        !selectIsland ||
        !selectSex ||
        !div
      ) {
        return;
      }

      const species =
        selectSpecies.value;

      const island =
        selectIsland.value;

      const sex =
        selectSex.value;

      const filteredPenguins =
        penguins.filter(
          (penguin) =>
            (
              species === "" ||
              penguin.species === species
            ) &&
            (
              island === "" ||
              penguin.island === island
            ) &&
            (
              sex === "" ||
              penguin.sex === sex
            )
        );

      if (resultCount) {
        resultCount.innerText =
          `${filteredPenguins.length} manchot(s) affiché(s)`;
      }

      div.innerHTML = "";

      const plot =
        Plot.plot({
          width: 900,
          height: 550,

          marginLeft: 70,
          marginBottom: 60,

          style: {
            background: "transparent",
            color: "#fff8f5"
          },

          color: {
            legend: true
          },

          x: {
            label: "Longueur du bec (mm)",
            grid: true
          },

          y: {
            label: "Profondeur du bec (mm)",
            grid: true
          },

          marks: [
            Plot.dot(
              penguins,
              {
                filter: (penguin) =>
                  (
                    species === "" ||
                    penguin.species === species
                  ) &&
                  (
                    island === "" ||
                    penguin.island === island
                  ) &&
                  (
                    sex === "" ||
                    penguin.sex === sex
                  ),

                x: "culmen_length_mm",
                y: "culmen_depth_mm",
                stroke: "species",
                r: 5
              }
            )
          ]
        });

      div.append(plot);
    }

    selectSpecies?.addEventListener(
      "change",
      renderPlot
    );

    selectIsland?.addEventListener(
      "change",
      renderPlot
    );

    selectSex?.addEventListener(
      "change",
      renderPlot
    );

    renderPlot();
  </script>

</Layout>