---
import Layout from "../layouts/Layout.astro";
---

<Layout title="TP Observable Plot - Client">

  <main class="mx-auto max-w-7xl px-6 py-16 lg:px-10">

    <section class="py-16">

      <p
        class="mb-4 text-sm font-bold uppercase
               tracking-[0.2em] text-[#ff9bb2]"
      >
        Astro × Observable Plot
      </p>

      <h1
        class="max-w-5xl text-6xl font-bold
               leading-[0.95] tracking-tight
               text-[#fff8f5]
               md:text-8xl"
      >
        Graphiques

        <span class="block text-[#ff9bb2]">
          côté client.
        </span>
      </h1>

      <p
        class="mt-7 max-w-2xl text-lg
               leading-8 text-[#e6d6da]"
      >
        Plusieurs essais permettent de comprendre
        comment générer et mettre à jour un graphique
        Observable Plot directement dans le navigateur.
      </p>

    </section>


    <section class="pb-20">

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">

        <a
          href="/simple/"
          class="flex min-h-64 flex-col
                 rounded-3xl border-2 border-[#704052]
                 bg-[#21131b] p-8
                 transition hover:-translate-y-1
                 hover:border-[#ff9bb2]"
        >

          <span
            class="mb-14 font-bold
                   text-[#ff9bb2]"
          >
            01
          </span>

          <p
            class="text-sm font-bold uppercase
                   tracking-[0.15em] text-[#ffd0db]"
          >
            Premier essai
          </p>

          <h2
            class="mt-3 text-3xl font-bold
                   text-[#fff8f5]"
          >
            Simple
          </h2>

          <p
            class="mt-4 leading-7
                   text-[#e6d6da]"
          >
            Premier graphique Observable Plot
            généré en JavaScript côté client.
          </p>

        </a>


        <a
          href="/simple-penguin/"
          class="flex min-h-64 flex-col
                 rounded-3xl border-2 border-[#704052]
                 bg-[#21131b] p-8
                 transition hover:-translate-y-1
                 hover:border-[#ff9bb2]"
        >

          <span
            class="mb-14 font-bold
                   text-[#ff9bb2]"
          >
            02
          </span>

          <p
            class="text-sm font-bold uppercase
                   tracking-[0.15em] text-[#ffd0db]"
          >
            Dataset JSON
          </p>

          <h2
            class="mt-3 text-3xl font-bold
                   text-[#fff8f5]"
          >
            Simple Penguin
          </h2>

          <p
            class="mt-4 leading-7
                   text-[#e6d6da]"
          >
            Affichage du dataset Penguins
            sans filtre.
          </p>

        </a>


        <a
          href="/penguin-filtre/"
          class="flex min-h-64 flex-col
                 rounded-3xl border-2 border-[#704052]
                 bg-[#21131b] p-8
                 transition hover:-translate-y-1
                 hover:border-[#ff9bb2]"
        >

          <span
            class="mb-14 font-bold
                   text-[#ff9bb2]"
          >
            03
          </span>

          <p
            class="text-sm font-bold uppercase
                   tracking-[0.15em] text-[#ffd0db]"
          >
            Un filtre
          </p>

          <h2
            class="mt-3 text-3xl font-bold
                   text-[#fff8f5]"
          >
            Penguin avec filtre
          </h2>

          <p
            class="mt-4 leading-7
                   text-[#e6d6da]"
          >
            Le select Species pilote
            directement le graphique.
          </p>

        </a>


        <a
          href="/penguin-filtres/"
          class="flex min-h-64 flex-col
                 rounded-3xl border-2 border-[#704052]
                 bg-[#21131b] p-8
                 transition hover:-translate-y-1
                 hover:border-[#ff9bb2]"
        >

          <span
            class="mb-14 font-bold
                   text-[#ff9bb2]"
          >
            04
          </span>

          <p
            class="text-sm font-bold uppercase
                   tracking-[0.15em] text-[#ffd0db]"
          >
            Plusieurs filtres
          </p>

          <h2
            class="mt-3 text-3xl font-bold
                   text-[#fff8f5]"
          >
            Penguins avancé
          </h2>

          <p
            class="mt-4 leading-7
                   text-[#e6d6da]"
          >
            Species, island et sex sont combinés
            pour mettre à jour le graphique.
          </p>

        </a>


        <a
          href="/cars-filtre/"
          class="flex min-h-64 flex-col
                 rounded-3xl border-2 border-[#355d73]
                 bg-[#15232c] p-8
                 transition hover:-translate-y-1
                 hover:border-[#8fd3ff]"
        >

          <span
            class="mb-14 font-bold
                   text-[#8fd3ff]"
          >
            05
          </span>

          <p
            class="text-sm font-bold uppercase
                   tracking-[0.15em] text-[#b9e4ff]"
          >
            Autre dataset
          </p>

          <h2
            class="mt-3 text-3xl font-bold
                   text-[#fff8f5]"
          >
            Cars
          </h2>

          <p
            class="mt-4 leading-7
                   text-[#e6d6da]"
          >
            La même méthode est appliquée
            à un autre jeu de données.
          </p>

        </a>

      </div>

    </section>

  </main>

</Layout>