---
import Layout from "../layouts/Layout.astro";
---

<Layout title="TP Observable Plot — Client">

  <main class="mx-auto max-w-7xl px-6 py-16 lg:px-10">

    <section class="py-16">

      <p
        class="mb-4 text-sm font-bold uppercase
               tracking-[0.2em] text-[#d06a80]"
      >
        Astro × Observable Plot
      </p>

      <h1
        class="max-w-5xl text-6xl font-bold
               leading-[0.95] tracking-tight
               md:text-8xl"
      >
        Graphiques

        <span class="block text-[#d06a80]">
          côté client.
        </span>
      </h1>

      <p
        class="mt-7 max-w-2xl text-lg
               leading-8 text-[#c2aeb3]"
      >
        Plusieurs essais permettent de comprendre
        comment générer et mettre à jour un graphique
        Observable Plot directement dans le navigateur.
      </p>

    </section>


    <section class="pb-20">

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">

        <a
          href="/simple/"
          class="flex min-h-80 flex-col justify-between
                 rounded-3xl border border-[#4b2936]
                 bg-[#21131b] p-8
                 transition hover:-translate-y-1
                 hover:border-[#d06a80]
                 focus-visible:outline
                 focus-visible:outline-4
                 focus-visible:outline-offset-4
                 focus-visible:outline-[#d06a80]"
        >

          <span class="font-bold text-[#d06a80]">
            01
          </span>

          <div>

            <p
              class="text-sm font-bold uppercase
                     tracking-[0.15em] text-[#a98b96]"
            >
              Premier essai
            </p>

            <h2 class="mt-3 text-4xl font-bold">
              Simple
            </h2>

            <p class="mt-4 text-[#c2aeb3]">
              Premier graphique Observable Plot
              généré en JavaScript côté client.
            </p>

          </div>

        </a>


        <a
          href="/simple-penguin/"
          class="flex min-h-80 flex-col justify-between
                 rounded-3xl border border-[#4b2936]
                 bg-[#21131b] p-8
                 transition hover:-translate-y-1
                 hover:border-[#d06a80]
                 focus-visible:outline
                 focus-visible:outline-4
                 focus-visible:outline-offset-4
                 focus-visible:outline-[#d06a80]"
        >

          <span class="font-bold text-[#d06a80]">
            02
          </span>

          <div>

            <p
              class="text-sm font-bold uppercase
                     tracking-[0.15em] text-[#a98b96]"
            >
              Dataset JSON
            </p>

            <h2 class="mt-3 text-4xl font-bold">
              Simple Penguin
            </h2>

            <p class="mt-4 text-[#c2aeb3]">
              Affichage du dataset Penguins
              sans filtre.
            </p>

          </div>

        </a>


        <a
          href="/penguin-filtre/"
          class="flex min-h-80 flex-col justify-between
                 rounded-3xl border border-[#4b2936]
                 bg-[#21131b] p-8
                 transition hover:-translate-y-1
                 hover:border-[#d06a80]
                 focus-visible:outline
                 focus-visible:outline-4
                 focus-visible:outline-offset-4
                 focus-visible:outline-[#d06a80]"
        >

          <span class="font-bold text-[#d06a80]">
            03
          </span>

          <div>

            <p
              class="text-sm font-bold uppercase
                     tracking-[0.15em] text-[#a98b96]"
            >
              Un filtre
            </p>

            <h2 class="mt-3 text-4xl font-bold">
              Penguin avec filtre
            </h2>

            <p class="mt-4 text-[#c2aeb3]">
              Le select Species pilote
              directement le graphique.
            </p>

          </div>

        </a>


        <a
          href="/penguin-filtres/"
          class="flex min-h-80 flex-col justify-between
                 rounded-3xl border border-[#4b2936]
                 bg-[#21131b] p-8
                 transition hover:-translate-y-1
                 hover:border-[#d06a80]
                 focus-visible:outline
                 focus-visible:outline-4
                 focus-visible:outline-offset-4
                 focus-visible:outline-[#d06a80]"
        >

          <span class="font-bold text-[#d06a80]">
            04
          </span>

          <div>

            <p
              class="text-sm font-bold uppercase
                     tracking-[0.15em] text-[#a98b96]"
            >
              Plusieurs filtres
            </p>

            <h2 class="mt-3 text-4xl font-bold">
              Penguins avancé
            </h2>

            <p class="mt-4 text-[#c2aeb3]">
              Species, island et sex
              sont combinés.
            </p>

          </div>

        </a>


        <a
          href="/cars-filtre/"
          class="flex min-h-80 flex-col justify-between
                 rounded-3xl border border-[#32495a]
                 bg-[#111b23] p-8
                 transition hover:-translate-y-1
                 hover:border-[#72a7cf]
                 focus-visible:outline
                 focus-visible:outline-4
                 focus-visible:outline-offset-4
                 focus-visible:outline-[#72a7cf]"
        >

          <span class="font-bold text-[#72a7cf]">
            05
          </span>

          <div>

            <p
              class="text-sm font-bold uppercase
                     tracking-[0.15em] text-[#9fc3dd]"
            >
              Autre dataset
            </p>

            <h2 class="mt-3 text-4xl font-bold">
              Cars
            </h2>

            <p class="mt-4 text-[#b8cbd8]">
              La même méthode est appliquée
              à un autre jeu de données.
            </p>

          </div>

        </a>

      </div>

    </section>

  </main>

</Layout>
