---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Cars avec filtre — Observable Plot">

  <main class="mx-auto max-w-7xl px-6 py-12 lg:px-12 lg:py-16">

    <a
      href="/"
      class="inline-block text-sm font-bold
             text-[#8fd3ff]
             transition hover:text-[#c7eaff]"
    >
      ← Retour à l'accueil
    </a>

    <header class="max-w-4xl pt-16 pb-12">

      <p
        class="mb-4 text-xs font-bold uppercase
               tracking-[0.22em] text-[#8fd3ff]"
      >
        Essai 05 — Autre dataset
      </p>

      <h1
        class="text-5xl font-bold
               leading-tight tracking-[-0.03em]
               text-[#fff8f5]
               md:text-7xl"
      >
        Cars
      </h1>

      <p
        class="mt-5 max-w-2xl
               text-lg leading-8
               text-[#e4d7db]"
      >
        Explore la relation entre la puissance
        et la consommation des voitures selon
        leur origine.
      </p>

    </header>

    <section
      class="border-y border-[#3d4f5b]
             py-7"
    >

      <div
        class="grid gap-6
               md:grid-cols-[1fr_auto]
               md:items-end"
      >

        <div class="max-w-md">

          <label
            for="origin"
            class="mb-2 block
                   text-xs font-bold uppercase
                   tracking-[0.15em]
                   text-[#c4d6e2]"
          >
            Origine
          </label>

          <select
            id="origin"
            class="w-full rounded-lg
                   border border-[#52758a]
                   bg-[#14212a]
                   px-4 py-3
                   text-[#fff8f5]
                   transition
                   hover:border-[#8fd3ff]
                   focus:border-[#8fd3ff]"
          >
            <option value="">
              Toutes les origines
            </option>

            <option value="USA">
              USA
            </option>

            <option value="Europe">
              Europe
            </option>

            <option value="Japan">
              Japon
            </option>
          </select>

        </div>

        <div
          class="border-l-0 border-[#3d4f5b]
                 md:border-l md:pl-8"
        >

          <p
            class="text-xs font-bold uppercase
                   tracking-[0.15em]
                   text-[#c4d6e2]"
          >
            Résultats
          </p>

          <p
            id="result-count"
            class="mt-1 text-3xl font-bold
                   text-[#8fd3ff]"
            aria-live="polite"
          >
          </p>

        </div>

      </div>

    </section>

    <section class="pt-12">

      <div
        class="mb-6 flex flex-col gap-3
               md:flex-row
               md:items-end
               md:justify-between"
      >

        <div>

          <p
            class="text-xs font-bold uppercase
                   tracking-[0.18em]
                   text-[#8fd3ff]"
          >
            Visualisation
          </p>

          <h2
            class="mt-2 text-2xl font-bold
                   text-[#fff8f5]"
          >
            Puissance et consommation
          </h2>

        </div>

        <p
          class="max-w-sm text-sm
                 leading-6 text-[#c4d6e2]"
        >
          Chaque point représente une voiture.
          La couleur correspond à son origine.
        </p>

      </div>

      <div
        class="overflow-hidden
               rounded-xl
               bg-[#f4f7f9]
               p-4
               md:p-8"
      >

        <div
          id="plot"
          class="overflow-x-auto"
        >
        </div>

      </div>

    </section>

  </main>

  <script>
    import * as Plot from "@observablehq/plot";
    import cars from "../assets/cars.json";

    const selectOrigin =
      document.querySelector<HTMLSelectElement>(
        "#origin"
      );

    const div =
      document.querySelector<HTMLElement>(
        "#plot"
      );

    const resultCount =
      document.querySelector<HTMLElement>(
        "#result-count"
      );

    function renderPlot() {

      if (
        !selectOrigin ||
        !div
      ) {
        return;
      }

      const origin =
        selectOrigin.value;

      const filteredCars =
        cars.filter(
          (car) =>
            (
              origin === "" ||
              car.Origin === origin
            ) &&
            car.Horsepower != null &&
            car.Miles_per_Gallon != null
        );

      if (resultCount) {
        resultCount.innerText =
          filteredCars.length.toString();
      }

      div.innerHTML = "";

      const width =
        Math.max(
          700,
          Math.min(
            1100,
            div.clientWidth
          )
        );

      const plot =
        Plot.plot({

          width,

          height: 520,

          marginTop: 40,
          marginRight: 40,
          marginBottom: 65,
          marginLeft: 75,

          style: {
            background: "transparent",
            color: "#18242c",
            fontSize: "13px"
          },

          color: {
            domain: [
              "USA",
              "Europe",
              "Japan"
            ],

            range: [
              "#3159b7",
              "#c27a00",
              "#c94d64"
            ],

            legend: true
          },

          x: {
            label: "Puissance",
            grid: true,
            nice: true
          },

          y: {
            label: "Miles per gallon",
            grid: true,
            nice: true
          },

          marks: [

            Plot.dot(
              cars,
              {
                filter: (car) =>
                  (
                    origin === "" ||
                    car.Origin === origin
                  ) &&
                  car.Horsepower != null &&
                  car.Miles_per_Gallon != null,

                x: "Horsepower",
                y: "Miles_per_Gallon",

                fill: "Origin",

                stroke: "#ffffff",
                strokeWidth: 1.2,

                r: 6,
                opacity: 0.9,

                title: (car) =>
                  `${car.Name} · ${car.Origin}`
              }
            )

          ]

        });

      div.append(plot);
    }

    selectOrigin?.addEventListener(
      "change",
      renderPlot
    );

    renderPlot();
  </script>

</Layout>