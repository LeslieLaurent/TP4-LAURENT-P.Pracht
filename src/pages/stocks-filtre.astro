---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Stocks avec filtre - Observable Plot">

  <main class="mx-auto max-w-7xl px-6 py-12 lg:px-12 lg:py-16">

    <a
      href="/"
      class="inline-block text-sm font-bold
             text-[#7ee0c3]
             transition hover:text-[#b8f4e3]"
    >
      ← Retour à l'accueil
    </a>

    <header class="max-w-4xl pt-16 pb-12">

      <p
        class="mb-4 text-xs font-bold uppercase
               tracking-[0.22em] text-[#7ee0c3]"
      >
        Essai 06 — Dataset supplémentaire
      </p>

      <h1
        class="text-5xl font-bold
               leading-tight tracking-[-0.03em]
               text-[#fff8f5]
               md:text-7xl"
      >
        Stocks
      </h1>

      <p
        class="mt-5 max-w-2xl
               text-lg leading-8
               text-[#e4d7db]"
      >
        Explore l'évolution du cours des actions
        selon l'entreprise sélectionnée.
      </p>

    </header>

    <section
      class="border-y border-[#35584f]
             py-7"
    >

      <div
        class="grid gap-6
               md:grid-cols-[1fr_auto]
               md:items-end"
      >

        <div class="max-w-md">

          <label
            for="symbol"
            class="mb-2 block
                   text-xs font-bold uppercase
                   tracking-[0.15em]
                   text-[#c6ddd6]"
          >
            Entreprise
          </label>

          <select
            id="symbol"
            class="w-full rounded-lg
                   border border-[#4f8073]
                   bg-[#11241f]
                   px-4 py-3
                   text-[#fff8f5]
                   transition
                   hover:border-[#7ee0c3]
                   focus:border-[#7ee0c3]"
          >
            <option value="">
              Toutes les entreprises
            </option>

            <option value="AAPL">
              Apple
            </option>

            <option value="AMZN">
              Amazon
            </option>

            <option value="GOOG">
              Google
            </option>

            <option value="IBM">
              IBM
            </option>

            <option value="MSFT">
              Microsoft
            </option>
          </select>

        </div>

        <div
          class="border-l-0 border-[#35584f]
                 md:border-l md:pl-8"
        >

          <p
            class="text-xs font-bold uppercase
                   tracking-[0.15em]
                   text-[#c6ddd6]"
          >
            Données affichées
          </p>

          <p
            id="result-count"
            class="mt-1 text-3xl font-bold
                   text-[#7ee0c3]"
            aria-live="polite"
          >
            ...
          </p>

        </div>

      </div>

    </section>

    <section class="pt-12">

      <div
        class="mb-6 flex flex-col gap-3
               md:flex-row
               md:items-end
               md:justify-between"
      >

        <div>

          <p
            class="text-xs font-bold uppercase
                   tracking-[0.18em]
                   text-[#7ee0c3]"
          >
            Visualisation
          </p>

          <h2
            class="mt-2 text-2xl font-bold
                   text-[#fff8f5]"
          >
            Évolution du cours des actions
          </h2>

        </div>

        <p
          class="max-w-sm text-sm
                 leading-6 text-[#c6ddd6]"
        >
          Chaque courbe représente une entreprise.
          Le graphique évolue selon la sélection.
        </p>

      </div>

      <div
        class="overflow-hidden
               rounded-xl
               bg-[#f5f7f6]
               p-4
               md:p-8"
      >

        <div
          id="plot"
          class="overflow-x-auto"
        >
        </div>

      </div>

    </section>

  </main>

  <script>
    import * as Plot from "@observablehq/plot";

    const selectSymbol =
      document.querySelector<HTMLSelectElement>(
        "#symbol"
      );

    const div =
      document.querySelector<HTMLElement>(
        "#plot"
      );

    const resultCount =
      document.querySelector<HTMLElement>(
        "#result-count"
      );

    let stocks: {
      symbol: string;
      date: Date;
      price: number;
    }[] = [];


    function renderPlot() {

      if (
        !selectSymbol ||
        !div
      ) {
        return;
      }


      const symbol =
        selectSymbol.value;


      const filteredStocks =
        stocks.filter(
          (stock) =>
            symbol === "" ||
            stock.symbol === symbol
        );


      if (resultCount) {
        resultCount.innerText =
          filteredStocks.length.toString();
      }


      div.innerHTML = "";


      const width =
        Math.max(
          700,
          Math.min(
            1100,
            div.clientWidth
          )
        );


      const plot =
        Plot.plot({

          width,

          height: 520,

          marginTop: 40,
          marginRight: 40,
          marginBottom: 65,
          marginLeft: 75,

          style: {
            background: "transparent",
            color: "#18241f",
            fontSize: "13px"
          },

          color: {
            legend: true
          },

          x: {
            label: "Date",
            grid: true
          },

          y: {
            label: "Prix",
            grid: true,
            nice: true
          },

          marks: [

            Plot.line(
              stocks,
              {
                filter: (stock) =>
                  symbol === "" ||
                  stock.symbol === symbol,

                x: "date",

                y: "price",

                stroke: "symbol",

                strokeWidth: 2.5
              }
            ),

            Plot.dot(
              stocks,
              {
                filter: (stock) =>
                  (
                    symbol === "" ||
                    stock.symbol === symbol
                  ),

                x: "date",

                y: "price",

                fill: "symbol",

                r: 2.5,

                title: (stock) =>
                  `${stock.symbol} · ${stock.price}`
              }
            )

          ]

        });


      div.append(plot);

    }


    async function loadStocks() {

      if (!resultCount) {
        return;
      }


      try {

        const response =
          await fetch(
            "https://vega.github.io/vega-datasets/data/stocks.csv"
          );


        if (!response.ok) {
          throw new Error(
            "Impossible de charger les données."
          );
        }


        const csv =
          await response.text();


        const lines =
          csv
            .trim()
            .split(/\r?\n/);


        stocks =
          lines
            .slice(1)
            .map((line) => {

              const [
                symbol,
                date,
                price
              ] =
                line.split(",");


              return {
                symbol:
                  symbol.trim(),

                date:
                  new Date(
                    date.trim()
                  ),

                price:
                  Number(
                    price.trim()
                  )
              };

            })
            .filter(
              (stock) =>
                stock.symbol &&
                !Number.isNaN(
                  stock.date.getTime()
                ) &&
                Number.isFinite(
                  stock.price
                )
            );


        renderPlot();

      }

      catch (error) {

        resultCount.innerText =
          "Erreur";


        console.error(error);

      }

    }


    selectSymbol?.addEventListener(
      "change",
      renderPlot
    );


    loadStocks();
  </script>

</Layout>