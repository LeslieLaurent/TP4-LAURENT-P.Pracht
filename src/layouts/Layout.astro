---
import "../styles/global.css";

interface Props {
  title?: string;
}

const {
  title = "Observable Plot — TP"
} = Astro.props;
---

<!doctype html>

<html lang="fr">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <meta
      name="generator"
      content={Astro.generator}
    />

    <meta
      name="description"
      content="TP Astro et Observable Plot."
    />

    <title>{title}</title>

  </head>

  <body
    class="min-h-screen bg-[#0d090c] text-[#fff8f5]"
  >

    <slot />

  </body>

</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  body {
    background: #0d090c;
    color: #fff8f5;
  }

  :global(a:focus-visible),
  :global(button:focus-visible),
  :global(select:focus-visible) {
    outline: 3px solid #ff9bb2;
    outline-offset: 4px;
  }

  :global(select) {
    color-scheme: dark;
  }
</style>